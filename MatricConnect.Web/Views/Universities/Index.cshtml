@* Programmer name : Lerato Molefe
   Project name    : Matric Connect
   Purpose         : Displays province selection and university search results.
*@

@model MatricConnect.Web.Models.UniversitySearchViewModel

@{
    ViewData["Title"] = "Search Universities";
    bool searchSubmitted = Context.Request.Query.ContainsKey(nameof(Model.SelectedProvince));
    bool validSearch = searchSubmitted && ViewData.ModelState.IsValid;
    var universityCount = Model.Universities.Count;
    bool hasResults = validSearch && universityCount > 0;
    bool isEmpty = validSearch && universityCount == 0;
    var universityLabel = universityCount == 1 ? "university" : "universities";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">
        @successMessage
    </div>
}

@if (isEmpty)
{
    <div class="mc-browse-flow mc-search-empty">
        <p class="mc-browse-eyebrow">Search results</p>
        <h1 class="mc-browse-title">No universities listed yet</h1>
        <p class="mc-search-empty-description">There are no universities in our catalogue for this province. Try another province.</p>
        <a asp-controller="Universities" asp-action="Index" class="btn mc-browse-button mc-search-reset">
            Choose another province
        </a>
        <p class="mc-browse-note">This reflects our catalogue, not every university in South Africa.</p>
    </div>
}
else
{
    <div class="mc-browse-flow @(hasResults ? "mc-search-with-results" : null)">
        <p class="mc-browse-eyebrow">Explore your options</p>
        <h1 class="mc-browse-title">@(hasResults ? "Find your university" : "Where would you like to study?")</h1>

        @if (hasResults)
        {
            <p class="mc-browse-description">Choose a province to browse universities and their programmes.</p>
        }

        <form asp-controller="Universities" asp-action="Index" method="get" class="mc-province-form">
            <div class="mc-province-field">
                <label asp-for="SelectedProvince" class="mc-province-label">Province</label>
                <select asp-for="SelectedProvince" class="form-select mc-province-select"
                        aria-describedby="province-help province-error"
                        aria-invalid="@(!ViewData.ModelState.IsValid ? "true" : null)">
                    <option value="">Select province</option>
                    @foreach (var province in Model.Provinces)
                    {
                        <option value="@province">@province</option>
                    }
                </select>
                <p id="province-help" class="mc-province-help">Choose where you want to study.</p>
                <span id="province-error" asp-validation-for="SelectedProvince" class="text-danger"></span>
            </div>
            <button type="submit" class="btn mc-browse-button">Find universities</button>
        </form>

        @if (hasResults)
        {
            <section class="mc-browse-flow" aria-labelledby="university-results-heading">
                <h2 id="university-results-heading" class="mc-browse-heading">@universityCount @universityLabel in @Model.SelectedProvince</h2>
                <ul class="mc-browse-results">
                    @foreach (var university in Model.Universities)
                    {
                        var programmeLabel = university.ProgrammeCount == 1 ? "programme" : "programmes";
                        <li class="mc-browse-card mc-university-card">
                            <h3 class="mc-browse-heading">@university.Name</h3>
                            <p class="mc-browse-note">@university.Province · @university.ProgrammeCount @programmeLabel</p>
                            <a asp-controller="Universities" asp-action="Programmes" asp-route-id="@university.Id"
                               class="btn mc-browse-button" aria-label="View programmes at @university.Name">
                                View programmes
                            </a>
                        </li>
                    }
                </ul>
                <p class="mc-browse-note">You can browse a different province without changing your home province.</p>
            </section>
        }
        else
        {
            <p class="mc-browse-note">Choose a province to see the universities listed in our catalogue.</p>
        }
    </div>
}
