@* Programmer name : Lerato Molefe
   Project name    : Matric Connect
   Purpose         : Displays programmes saved by the selected student.
*@

@model MatricConnect.Web.Models.SavedProgrammesViewModel

@{
    ViewData["Title"] = "Saved Programmes";
    var savedCount = Model.SavedProgrammes.Count;
    var programmeLabel = savedCount == 1 ? "programme" : "programmes";
}

<div class="mc-browse-flow">
    <p class="mc-browse-eyebrow">Your shortlist</p>
    <h1 class="mc-browse-title">Saved programmes</h1>
    <p class="mc-browse-note">Saved by <strong>@Model.Student.FirstName @Model.Student.LastName</strong> · Student ID @Model.Student.Id</p>

    <div class="mc-saved-actions">
        <a asp-controller="Universities" asp-action="Index" class="btn mc-browse-button">Find more programmes</a>
        <a asp-controller="Students" asp-action="Existing" asp-route-returnUrl="@Url.Action("Index", "SavedProgrammes")"
           class="btn mc-browse-button mc-browse-button-secondary">Select another profile</a>
    </div>

    @if (TempData["SavedProgrammesMessage"] is string message)
    {
        <p class="mc-saved-status" role="status">@message</p>
    }

    @if (savedCount == 0)
    {
        <section class="mc-saved-empty" aria-labelledby="saved-empty-title">
            <h2 id="saved-empty-title" class="mc-browse-heading">No saved programmes yet</h2>
            <p class="mc-browse-note">Browse universities, check a programme’s requirements, and save it here to revisit later.</p>
        </section>
    }
    else
    {
        <section class="mc-browse-flow" aria-labelledby="saved-programmes-heading">
            <h2 id="saved-programmes-heading" class="mc-browse-heading">@savedCount saved @programmeLabel</h2>
            <ul class="mc-browse-results">
                @foreach (var saved in Model.SavedProgrammes)
                {
                    <li class="mc-browse-card mc-saved-card">
                        <h3 class="mc-browse-heading">@saved.Programme.Name</h3>
                        <p class="mc-browse-note">@saved.Programme.University.Name · @saved.Programme.University.Province</p>
                        <div class="mc-saved-card-actions">
                            <a asp-controller="Universities" asp-action="ProgrammeDetails" asp-route-id="@saved.ProgrammeId"
                               class="btn mc-browse-button" aria-label="View requirements for @saved.Programme.Name">View requirements</a>
                            <form asp-controller="SavedProgrammes" asp-action="Remove" asp-route-id="@saved.ProgrammeId" method="post">
                                <button type="submit" class="btn mc-browse-button mc-browse-button-secondary mc-saved-remove"
                                        aria-label="Remove @saved.Programme.Name from saved programmes">Remove</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
            <p class="mc-browse-note">Saving keeps a programme for later. It does not submit an application.</p>
        </section>
    }
</div>
