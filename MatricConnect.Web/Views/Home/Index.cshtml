@* Programmer name : Lerato Molefe
   Project name    : Matric Connect
   Purpose         : Presents the dashboard and links to the main student journeys.
*@

@inject MatricConnect.Web.Services.SelectedStudentContext SelectedStudent

@{
    ViewData["Title"] = "Dashboard";

    var student = SelectedStudent.GetStudent(Context);
    var actions = new[]
    {
        (Title: "Create Student Profile", Description: "Add your matric results to check programme requirements.", Controller: "Students", Action: "Create", Tone: "teal", Icon: "profile"),
        (Title: "Existing Student", Description: "Access your saved profile using your Student ID.", Controller: "Students", Action: "Existing", Tone: "blue", Icon: "students"),
        (Title: "Find Institutions", Description: "Browse public universities and TVET colleges by province.", Controller: "Universities", Action: "Index", Tone: "terracotta", Icon: "search"),
        (Title: "View Saved Programmes", Description: "View and manage your saved programmes.", Controller: "SavedProgrammes", Action: "Index", Tone: "gold", Icon: "bookmark")
    };
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success mc-dashboard-alert" role="status">
        @successMessage
    </div>
}

<section class="mc-hero" aria-labelledby="dashboard-title">
    <picture class="mc-hero-image">
        <source media="(max-width: 991.98px)" srcset="@Url.Content("~/images/dashboard/mobile-hero.jpg")" />
        <img src="~/images/dashboard/hero.jpg" alt="" />
    </picture>

    <div class="mc-welcome">
        <p class="mc-eyebrow">Dashboard</p>
        <h1 id="dashboard-title">
            @if (student == null)
            {
                <text>Welcome to Matric Connect</text>
            }
            else
            {
                <text>Welcome back, <span class="mc-welcome-name">@(student.FirstName)!</span></text>
            }
        </h1>
        <p>Find the right university programmes for your future.</p>
    </div>

    <p class="mc-hero-motto">Same<br />Matric.<br />More<br />Possibilities.</p>
</section>

<nav class="mc-dashboard-actions" aria-label="Dashboard actions">
    @foreach (var item in actions)
    {
        <a class="mc-action mc-action--@item.Tone"
           asp-controller="@item.Controller"
           asp-action="@item.Action">
            <span class="mc-action-icon">
                <img class="d-none d-lg-block" src="~/images/dashboard/card-@(item.Icon).svg" alt="" />
                <img class="d-lg-none" src="~/images/dashboard/mobile-card-@(item.Icon).svg" alt="" />
            </span>

            <span class="mc-action-copy">
                <span class="mc-action-title">@item.Title</span>
                <span class="mc-action-description">@item.Description</span>
            </span>

            <span class="mc-action-arrow">
                <img class="d-none d-lg-block" src="~/images/dashboard/card-arrow.svg" alt="" />
                <img class="d-lg-none" src="~/images/dashboard/mobile-chevron.svg" alt="" />
            </span>
        </a>
    }
</nav>
