@* Programmer name : Lerato Molefe
   Project name    : Matric Connect
   Purpose         : Displays programme details, eligibility checking,
                     and the option to save after viewing the result.
*@

@model MatricConnect.Web.Models.ProgrammeDetailsViewModel

@{
    ViewData["Title"] = "Programme Details";
}

<h1>@Model.Programme.Name</h1>

<p class="lead">@Model.University.Name</p>

<p>
    <strong>Province:</strong> @Model.University.Province
</p>

<p>
    <strong>Field of study:</strong> @Model.Programme.FieldOfStudy
</p>

<a asp-controller="Universities"
   asp-action="Programmes"
   asp-route-id="@Model.University.Id"
   class="btn btn-outline-secondary mb-4">
    Back to Programmes
</a>

<div class="card">
    <div class="card-body">
        <h2 class="h4">Entry Requirements</h2>

        <dl class="row">
            <dt class="col-5">Minimum APS</dt>
            <dd class="col-7">@Model.Programme.RequiredAPS</dd>

            <dt class="col-5">Mathematics</dt>
            <dd class="col-7">
                @Model.Programme.RequiredMathematics.ToString("0.##")%
            </dd>

            <dt class="col-5">Physical Science</dt>
            <dd class="col-7">
                @if (Model.Programme.RequiredPhysicalScience.HasValue)
                {
                    <span>@Model.Programme.RequiredPhysicalScience.Value.ToString("0.##")%</span>
                }
                else
                {
                    <span>Not required</span>
                }
            </dd>

            <dt class="col-5">Application deadline</dt>
            <dd class="col-7">
                @Model.Programme.ApplicationDeadline.ToString("dd MMMM yyyy")
            </dd>
        </dl>

        <p class="text-muted mb-0">
            Universities may have additional admission requirements.
            Meeting these minimum requirements does not guarantee admission.
        </p>
    </div>
</div>

@if (TempData["SaveMessage"] is string saveMessage)
{
    <div class="alert alert-info mt-4" role="status">
        @saveMessage
    </div>
}

<div class="card mt-4">
    <div class="card-body">
        <h2 class="h4">Check Your Eligibility</h2>

        <p>
            Review or enter your academic results, then check your eligibility.
        </p>

        <form asp-controller="Universities"
              asp-action="CheckEligibility"
              asp-route-id="@Model.Programme.Id"
              method="post">

            <div class="mb-3">
                <label asp-for="EligibilityInput.APSScore"
                       class="form-label"></label>

                <input asp-for="EligibilityInput.APSScore"
                       class="form-control"
                       type="number"
                       min="0"
                       max="57"
                       step="1" />

                <span asp-validation-for="EligibilityInput.APSScore"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EligibilityInput.MathematicsMark"
                       class="form-label"></label>

                <input asp-for="EligibilityInput.MathematicsMark"
                       asp-format="{0:0.##}"
                       class="form-control"
                       type="number"
                       min="0"
                       max="100"
                       step="0.01" />

                <span asp-validation-for="EligibilityInput.MathematicsMark"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EligibilityInput.PhysicalScienceMark"
                       class="form-label"></label>

                <input asp-for="EligibilityInput.PhysicalScienceMark"
                       asp-format="{0:0.##}"
                       class="form-control"
                       type="number"
                       min="0"
                       max="100"
                       step="0.01" />

                <div class="form-text">
                    Leave blank if you do not take Physical Science.
                </div>

                <span asp-validation-for="EligibilityInput.PhysicalScienceMark"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Check Eligibility
            </button>
        </form>

        @if (Model.EligibilityChecked)
        {
            <div id="eligibility-result" class="mt-4">
                <div role="status">
                    @if (Model.EligibilityIssues.Count == 0)
                    {
                        <div class="alert alert-success">
                            You MEET the requirements currently evaluated
                            by Matric Connect.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <p>
                                You do not meet all the requirements currently
                                evaluated by Matric Connect:
                            </p>

                            <ul class="mb-0">
                                @foreach (var issue in Model.EligibilityIssues)
                                {
                                    <li>@issue</li>
                                }
                            </ul>
                        </div>

                        <p>
                            You can still save this programme to keep it
                            among your options.
                        </p>
                    }
                </div>

                <form asp-controller="SavedProgrammes"
                      asp-action="Save"
                      asp-route-id="@Model.Programme.Id"
                      method="post">
                    <button type="submit" class="btn btn-outline-primary">
                        Save Programme
                    </button>
                </form>

                <a asp-controller="SavedProgrammes"
                   asp-action="Index"
                   class="btn btn-link mt-2">
                    View Saved Programmes
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Hide the previous result and save button when academic input changes.
        document.querySelectorAll(
            'input[name^="EligibilityInput."]'
        ).forEach(function (input) {
            input.addEventListener('input', function () {
                const result = document.getElementById('eligibility-result');

                if (result) {
                    result.hidden = true;
                }
            });
        });
    </script>
}