@* Programmer name : Lerato Molefe
   Project name    : Matric Connect
   Purpose         : Displays programmes offered by the selected university.
*@

@model MatricConnect.Web.Models.UniversityProgrammesViewModel

@{
    ViewData["Title"] = "Browse Programmes";
    var programmeCount = Model.Programmes.Count + Model.References.Count;
    var faculties = Model.Programmes.Select(programme => programme.Faculty)
        .Concat(Model.References.Select(reference => reference.Group)).Distinct()
        .OrderBy(faculty => faculty == null).ThenBy(faculty => faculty).ToArray();
    var now = DateTimeOffset.UtcNow;
    var hasEligibilityCheck = Model.Programmes.Any(programme => programme.LatestVerifiedIntake == null);
    var programmeLabel = programmeCount == 1 ? "programme" : "programmes";
}

<div class="mc-browse-flow">
    <p class="mc-browse-eyebrow">@Model.University.Province / @Model.University.Name</p>
    <h1 class="mc-browse-title">Explore programmes</h1>
    @if (programmeCount > 0)
    {
        <p class="mc-browse-description">@(hasEligibilityCheck
            ? "Choose a programme to view its requirements and check your results."
            : "Explore programmes by faculty and check their published requirements.")</p>
    }

    <a asp-controller="Universities" asp-action="Index" asp-route-selectedProvince="@Model.University.Province"
       class="btn mc-browse-button mc-browse-button-secondary mc-programmes-back">
        Back to universities
    </a>

    @if (programmeCount == 0)
    {
        <p class="mc-browse-note">Programme details are not yet listed in Matric Connect.</p>
        @if (Uri.TryCreate(Model.University.Website, UriKind.Absolute, out var website) &&
            (website.Scheme == Uri.UriSchemeHttps || website.Scheme == Uri.UriSchemeHttp))
        {
            <a href="@website" class="btn mc-browse-button mc-programmes-back"
               aria-label="Visit the @Model.University.Name website">Visit official website</a>
        }
    }
    else
    {
        <section class="mc-browse-flow" aria-labelledby="programme-results-heading">
            <h2 id="programme-results-heading" class="mc-browse-heading">@programmeCount @programmeLabel at @Model.University.Name</h2>
            @if (faculties.Length > 1)
            {
                <nav aria-label="Faculties">
                    <ul>
                        @for (int i = 0; i < faculties.Length; i++)
                        {
                            <li><a href="#faculty-@i">@(faculties[i] ?? "Faculty not yet verified")</a></li>
                        }
                    </ul>
                </nav>
            }
            @for (int i = 0; i < faculties.Length; i++)
            {
                var faculty = faculties[i];
                <section class="mc-browse-flow" aria-labelledby="faculty-@i">
                    <h3 id="faculty-@i" class="mc-browse-heading">@(faculty ?? "Faculty not yet verified")</h3>
                    <ul class="mc-browse-results">
                    @foreach (var programme in Model.Programmes.Where(programme => programme.Faculty == faculty))
                    {
                    <li class="mc-browse-card">
                        <h4 class="mc-browse-heading">@programme.Name</h4>
                        @if (programme.LatestVerifiedIntake is { } intake)
                        {
                            var scoreSummary = string.IsNullOrWhiteSpace(intake.AdmissionScoreBySubject)
                                ? $"{intake.AdmissionScoreLabel} {intake.RequiredAps}+"
                                : $"{intake.AdmissionScoreLabel} varies by subject";
                            <p class="mc-browse-note">
                                @intake.IntakeYear intake@(intake.HasClosed(now) ? " (closed)" : "") · @scoreSummary
                            </p>
                        }
                        else
                        {
                            <p class="mc-browse-note">@programme.FieldOfStudy · APS @programme.RequiredAPS</p>
                        }
                        <a asp-controller="Universities" asp-action="ProgrammeDetails" asp-route-id="@programme.Id"
                           class="btn mc-browse-button" aria-label="View requirements for @programme.Name">
                            View requirements
                        </a>
                    </li>
                    }
                    @foreach (var programme in Model.References.Where(reference => reference.Group == faculty))
                    {
                        <partial name="_ProgrammeReference" model="programme" />
                    }
                    </ul>
                </section>
            }
            <p class="mc-browse-note">Check each programme's published requirements and confirm availability with the institution.</p>
        </section>
    }
</div>
