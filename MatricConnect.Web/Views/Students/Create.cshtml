@* Programmer name : Lerato Molefe
   Project name    : Matric Connect
   Purpose         : Displays the student profile creation form.
*@

@model MatricConnect.Web.Models.CreateStudentViewModel

@{
    ViewData["Title"] = "Create Student Profile";
    ViewData["StudentFlow"] = "Create";
    var returnUrl = Url.IsLocalUrl(Model.ReturnUrl) ? Model.ReturnUrl : null;
    ViewData["StudentReturnUrl"] = returnUrl;
    var cancelUrl = Url.Content(returnUrl) ?? Url.Action("Index", "Universities");
}

<section class="mc-student-flow mc-student-editor">
    <header class="mc-student-intro">
        <p class="mc-browse-eyebrow">Student profile</p>
        <h1 class="mc-browse-title">Create your <br class="mc-student-break" />student profile</h1>
        <p>Add your details and matric results to check programme requirements.</p>
    </header>

    <div class="mc-student-columns">
        <form asp-controller="Students" asp-action="Create" method="post" class="mc-student-card" novalidate>
            <input type="hidden" name="ReturnUrl" value="@returnUrl" />
            <partial name="_StudentProfileFields" model="Model" />

            <p class="mc-browse-note mc-editor-mobile-tip">Use your existing APS score. Leave Physical Science blank if not taken.</p>

            <div class="mc-student-actions">
                <button type="submit" class="btn mc-browse-button">Create profile</button>
                <a href="@cancelUrl" class="btn mc-browse-button mc-browse-button-secondary">Cancel</a>
            </div>
            <p class="mc-browse-note">Save your generated Student ID for returning visits.</p>
        </form>

        <aside class="mc-student-card mc-student-guide">
            <h2 class="mc-browse-heading">A clearer path forward</h2>
            <p>Use the APS score you already have. This form does not calculate APS.</p>
            <p>Physical Science is optional. Leave it blank if you did not take the subject.</p>
            <p class="mc-browse-note">Checks cover the requirements stored in Matric Connect.</p>
        </aside>
    </div>
</section>
